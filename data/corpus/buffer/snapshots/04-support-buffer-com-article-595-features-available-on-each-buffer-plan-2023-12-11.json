hasClass(\"selected\")\n    ) {\n      var clickCount = 0;\n      $(\"button.rateAction--negative\").on(\"click\", function (e) {\n        clickCount++;\n        if (clickCount % 2 === 1) {\n          hj(\"trigger\", \"articleVoteDown\");\n        }\n      });\n    }\n  }\n\n  $(document).ready(function () {\n    articleVoteDownPressed();\n    \n    // Remove existing Footer\n    $(\"footer\").remove(); // Remove Existing Footer\n    \n    // Append Footer from Marketing Site\n    var $footer = $(\"<section class='footer'>\");\n    $footer.load(\"https://buffer.com/docs-footer\");\n    $(\"body\").append($footer);\n  });\n\n  window.addEventListener('load', async function() {\n    try {\n      // Fetch Account information from API Gateway\n      const account = await fetch('https://graph.buffer.com', {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        credentials: 'include',\n        body: JSON.stringify({ query: '{ account { id email isImpersonation currentOrganization{ id commonTrackingProperties { atEventBillingState atEventBillingPlan atEventBillingCycle atEventBillingGateway atEventIsNewBuffer atEventChannelQty}}}}' }),\n      }).then(res => res.json()).then(res => res.data?.account)\n\n      // If logged out visitor or impersonation, do nothing\n      if (!account || !!account.isImpersonation) return\n\n      if (analytics) {\n        await analytics.identify(account.id)\n      }\n\n      if(window.Beacon) {\n        window.Beacon('identify', {\n          email: account.email,\n        })\n      }\n\n      const trackingProperties =  {\n        organizationId: account?.currentOrganization?.id,\n        ...account?.currentOrganization?.commonTrackingProperties\n      }\n\n      if (window.location.pathname.startsWith(\"/article\")) {\n        analytics.track('Help Center Article Viewed', {\n          userId: account.id,\n          ...trackingProperties,\n          articleTitle: window.document.title.replace(' - Buffer Help Center','')\n        })\n      }\n\n      if(window.Beacon && analytics) {\n        window.Beacon('on', 'open', () => {\n          analytics.track('Help Scout Beacon Opened', {\n            userId: account.id,\n            ...trackingProperties\n          })\n        })\n\n        window.Beacon('on', 'close', () => {\n          analytics.track('Help Scout Beacon Closed', {\n            userId: account.id,\n            ...trackingProperties\n          })\n        })\n\n        window.Beacon('on', 'email-sent', () => {\n          analytics.track('Help Scout Beacon Email Sent', {\n            userId: account.id,\n            ...trackingProperties\n          })\n        })\n      }\n    } catch(e){}\n  })\n</script>\n<!-- End of tracking -->\n\n    \n</head>\n    \n    <body>\n        \n<header id=\"mainNav\" class=\"navbar\">\n    <div class=\"navbar-inner\">\n        <div class=\"container-fluid\">\n            <a class=\"brand\" href=\"/\">\n            \n                <span>Buffer Help Center</span>\n            \n            </a>\n            \n                <button type=\"button\" class=\"btn btn-navbar\" data-toggle=\"collapse\" data-target=\".nav-collapse\">\n                    <span class=\"sr-only\">Toggle Navigation</span>\n                    <span class=\"icon-bar\"></span>\n                    <span class=\"icon-bar\"></span>\n                    <span class=\"icon-bar\"></span>\n                </button>\n            \n            <div class=\"nav-collapse collapse\">\n                <nav role=\"navigation\"><!-- added for accessibility -->\n                <ul class=\"nav\">\n                    \n                    \n                    \n                        <li id=\"contact\"><a href=\"#\" class=\"contactUs\" onclick=\"window.Beacon('open')\">Get in touch</a></li>\n                        <li id=\"contactMobile\"><a href=\"#\" class=\"contactUs\" onclick=\"window.Beacon('open')\">Get in touch</a></li>\n                    \n                </ul>\n                </nav>\n            </div><!--/.nav-collapse -->\n        </div><!--/container-->\n    </div><!--/navbar-inner-->\n</header>\n        <section id=\"contentArea\" class=\"container-fluid\">\n            <div class=\"row-fluid\">\n                <section id=\"main-content\" class=\"span9\">\n                    <div class=\"contentWrapper\">\n                        \n    \n    <article id=\"fullArticle\">\n        <h1 class=\"title\">Features available on each Buffer plan</h1>\n    \n        <a href=\"javascript:window.print()\" class=\"printArticle\" title=\"Print this article\" aria-label=\"Print this Article\"><i class=\"icon-print\"></i></a>\n        <div class=\"callout\">\n <h4 id=\"01H804TT2EBJ9BEMQ62520RNW6\">⚡️ You're in the right article if you're looking to…</h4>\n <ul>\n  <li>compare our plans, based on their features.</li>\n  <li>see an overview of all Buffer features.</li>\n </ul>\n</div> \n<p>Have you seen our <a href=\"https://buffer.com/pricing\" target=\"_blank\" rel=\"noopener\">pricing page</a>? If you have, you might have noticed that we have four plans: Free, Essentials, Team, and Agency plans.&nbsp;</p>\n<p>The<em><strong> Free plan</strong></em> is ideal for individual users who are looking to schedule content on up to three social channels.</p>\n<p>The <em><strong>Essentials plan</strong></em> is geared towards individuals who want to schedule content for their brand’s social channels. The Essentials plan offers more features and includes access to Buffer’s advanced analytics, reporting, and engagement tools.</p>\n<p>The <em><strong>Team plan</strong></em> includes the same features as the Essentials plan, but includes unlimited users to help you collaborate on posts and manage your channels.</p>\n<p>If you’re managing 10 or more social channels, the Agency plan provides all of the features of both the Essentials and Team plan (the Agency plan also includes unlimited team members), at a lower price point. Your 11th channel and higher are priced at $6 a month (or $60 a year) instead of $12.</p>\n<p>Scan through our many features below, then head over to <a href=\"http://buffer.com/pricing\" target=\"_blank\">our pricing page</a> to start a free trial and test the features out yourself!</p> \n<div class=\"callout-blue\">\n <p>📝 Use our <a href=\"https://buffer.com/pricing-calculator\" target=\"_blank\">Pricing Calculator</a> for your tailored monthly or annual cost estimate.</p>\n</div> \n<table>\n <colgroup>\n  <col width=\"152\">\n  <col>\n  <col>\n  <col>\n  <col>\n </colgroup>\n <tbody>\n  <tr>\n   <td>&nbsp;</td>\n   <td><strong>Free plan</strong></td>\n   <td><strong>Essentials plan</strong></td>\n   <td><p><strong>Team plan</strong></p><br></td>\n   <td><strong>Agency plan</strong></td>\n  </tr>\n  <tr>\n   <td><strong>Plan information</strong></td>\n   <td>&nbsp;</td>\n   <td>&nbsp;</td>\n   <td>&nbsp;</td>\n   <td>&nbsp;</td>\n  </tr>\n  <tr>\n   <td>Monthly price</td>\n   <td>$0/month</td>\n   <td>$6/month per channel</td>\n   <td>$12/month per channel</td>\n   <td>$120/month for 10 channels. Additional channels are $6 each</td>\n  </tr>\n  <tr>\n   <td>Yearly price</td>\n   <td>$0/month</td>\n   <td>$60/year per channel</td>\n   <td>$120/year per channel</td>\n   <td>$1,200/year for 10 channels. $60/year for each additional channel</td>\n  </tr>\n  <tr>\n   <td>Number of channel connections</td>\n   <td>3</td>\n   <td>Unlimited ($6 per channel)</td>\n   <td>Unlimited ($12 per channel)</td>\n   <td>Unlimited ($120 for 10 channels, $6 for each additional channel)</td>\n  </tr>\n  <tr>\n   <td>Scheduled posts</td>\n   <td><p>10 per channel,</p><p>up to 30 total if you have 3 channels connected.</p></td>\n   <td>2,000</td>\n   <td>2,000</td>\n   <td>2,000</td>\n  </tr>\n  <tr>\n   <td>Included users</td>\n   <td>1</td>\n   <td>1</td>\n   <td>1</td>\n   <td>1</td>\n  </tr>\n  <tr>\n   <td>Invite additional users</td>\n   <td>0</td>\n   <td>0</td>\n   <td>Unlimited</td>\n   <td>Unlimited</td>\n  </tr>\n  <tr>\n   <td><strong>Channel integrations</strong></td>\n   <td>&nbsp;</td>\n   <td>&nbsp;</td>\n   <td>&nbsp;</td>\n   <td>&nbsp;</td>\n  </tr>\n  <tr>\n   <td><a href=\"https://buffer.helpscoutdocs.com/article/555-using-facebook-with-buffer\" target=\"_self\">Facebook Pages and groups</a></td>\n   <td>✓</td>\n   <td>✓</td>\n   <td>✓</td>\n   <td>✓</td>\n  </tr>\n  <tr>\n   <td><a href=\"https://buffer.helpscoutdocs.com/article/658-using-instagram-reminders\" target=\"_self\">Instagram Business accounts</a></td>\n   <td>✓</td>\n   <td>✓</td>\n   <td>✓</td>\n   <td>✓</td>\n  </tr>\n  <tr>\n   <td><a href=\"https://buffer.helpscoutdocs.com/article/561-using-twitter-with-buffer\" target=\"_self\">X/Twitter profiles</a></td>\n   <td>✓</td>\n   <td>✓</td>\n   <td>✓</td>\n   <td>✓</td>\n  </tr>\n  <tr>\n   <td><a href=\"https://buffer.helpscoutdocs.com/article/560-using-linkedin-with-buffer\" target=\"_self\">LinkedIn Pages and profiles</a></td>\n   <td>✓</td>\n   <td>✓</td>\n   <td>✓</td>\n   <td>✓</td>\n  </tr>\n  <tr>\n   <td><a href=\"https://buffer.helpscoutdocs.com/article/558-using-pinterest-with-buffer\" target=\"_self\">Pinterest business accounts</a></td>\n   <td>✓</td>\n   <td>✓</td>\n   <td>✓</td>\n   <td>✓</td>\n  </tr>\n  <tr>\n   <td><a href=\"https://buffer.helpscoutdocs.com/article/556-using-shopify-with-buffer\" target=\"_self\">Shopify stores (for analytics)&nbsp;</a></td>\n   <td>&nbsp;</td>\n   <td>✓</td>\n   <td>✓</td>\n   <td>✓</td>\n  </tr>\n  <tr>\n   <td><a href=\"https://buffer.helpscoutdocs.com/article/557-using-google-business-profiles-with-buffer\" target=\"_self\">Google Business Profiles</a></td>\n   <td>✓</td>\n   <td>✓</td>\n   <td>✓</td>\n   <td>✓</td>\n  </tr>\n  <tr>\n   <td><a href=\"https://buffer.helpscoutdocs.com/article/664-using-start-page-with-buffer\" target=\"_self\">Start Page</a></td>\n   <td>✓</td>\n   <td>✓</td>\n   <td>✓</td>\n   <td>✓</td>\n  </tr>\n  <tr>\n   <td><a href=\"https://buffer