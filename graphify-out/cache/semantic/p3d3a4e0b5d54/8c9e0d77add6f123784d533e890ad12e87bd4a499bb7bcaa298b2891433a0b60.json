{"nodes": [{"id": "eval_cases_fixtures_e17_agency_blog_2026_06_17_agency_blog_post", "label": "Buffer blog: every team feature agencies use (June 17, 2026)", "file_type": "document", "source_file": "eval/cases/fixtures/E17-agency-blog-2026-06-17.txt", "source_location": null, "source_url": null, "captured_at": "2026-06-17", "author": null, "contributor": null}, {"id": "eval_cases_fixtures_e17_agency_blog_2026_06_17_ideas_library_kanban", "label": "Ideas library with kanban board", "file_type": "concept", "source_file": "eval/cases/fixtures/E17-agency-blog-2026-06-17.txt", "source_location": null, "source_url": null, "captured_at": "2026-06-17", "author": null, "contributor": null}, {"id": "eval_cases_fixtures_e17_agency_blog_2026_06_17_unlimited_users_team_plan", "label": "Unlimited users on the Team plan (seat caps as switching trigger)", "file_type": "rationale", "source_file": "eval/cases/fixtures/E17-agency-blog-2026-06-17.txt", "source_location": null, "source_url": null, "captured_at": "2026-06-17", "author": null, "contributor": null, "rationale": "Agencies switch to Buffer when a competitor's seat cap (e.g. six users) forces shared logins; one customer managing 70+ channels across 60+ senior living communities moved for this reason."}, {"id": "eval_cases_fixtures_e17_agency_blog_2026_06_17_permissions_approval_workflows", "label": "Scoped permissions and approval workflows", "file_type": "concept", "source_file": "eval/cases/fixtures/E17-agency-blog-2026-06-17.txt", "source_location": null, "source_url": null, "captured_at": "2026-06-17", "author": null, "contributor": null}, {"id": "eval_cases_fixtures_e17_agency_blog_2026_06_17_client_approval_outside_buffer", "label": "Client approval still happens outside Buffer (Google Docs, email)", "file_type": "rationale", "source_file": "eval/cases/fixtures/E17-agency-blog-2026-06-17.txt", "source_location": null, "source_url": null, "captured_at": "2026-06-17", "author": null, "contributor": null, "rationale": "Getting a client to create an account and log in is a real barrier; agencies that moved approvals into Buffer report fewer post-publication errors. This motivates the Guest access roadmap item."}, {"id": "eval_cases_fixtures_e17_agency_blog_2026_06_17_community_inbox", "label": "Community inbox (comments from every channel in one view)", "file_type": "concept", "source_file": "eval/cases/fixtures/E17-agency-blog-2026-06-17.txt", "source_location": null, "source_url": null, "captured_at": "2026-06-17", "author": null, "contributor": null}, {"id": "eval_cases_fixtures_e17_agency_blog_2026_06_17_insights_reports_markdown", "label": "Insights and reports exported to CSV, PDF or markdown", "file_type": "rationale", "source_file": "eval/cases/fixtures/E17-agency-blog-2026-06-17.txt", "source_location": null, "source_url": null, "captured_at": "2026-06-17", "author": null, "contributor": null, "rationale": "Markdown is the most flexible export: it pastes into Notion or Linear and is the format AI assistants parse most reliably, letting agencies hand a report to an assistant for summaries or client emails."}, {"id": "eval_cases_fixtures_e17_agency_blog_2026_06_17_takeaways", "label": "Takeaways: personalized recommendations from performance data", "file_type": "concept", "source_file": "eval/cases/fixtures/E17-agency-blog-2026-06-17.txt", "source_location": null, "source_url": null, "captured_at": "2026-06-17", "author": null, "contributor": null}, {"id": "eval_cases_fixtures_e17_agency_blog_2026_06_17_enforceable_2fa", "label": "Enforceable two-factor authentication on the Team plan", "file_type": "rationale", "source_file": "eval/cases/fixtures/E17-agency-blog-2026-06-17.txt", "source_location": null, "source_url": null, "captured_at": "2026-06-17", "author": null, "contributor": null, "rationale": "Agencies hold client trust; one weak password can expose a dozen brands. Admin-enforced 2FA turns a 'please enable it' battle with volunteers and contractors into a system requirement."}, {"id": "eval_cases_fixtures_e17_agency_blog_2026_06_17_soc2_compliance", "label": "Buffer SOC 2 compliance", "file_type": "concept", "source_file": "eval/cases/fixtures/E17-agency-blog-2026-06-17.txt", "source_location": null, "source_url": null, "captured_at": "2026-06-17", "author": null, "contributor": null}, {"id": "eval_cases_fixtures_e17_agency_blog_2026_06_17_native_integrations", "label": "Native integrations: Canva, Zapier, Make, n8n, Google Photos, Unsplash", "file_type": "concept", "source_file": "eval/cases/fixtures/E17-agency-blog-2026-06-17.txt", "source_location": null, "source_url": null, "captured_at": "2026-06-17", "author": null, "contributor": null}, {"id": "eval_cases_fixtures_e17_agency_blog_2026_06_17_open_buffer_api", "label": "Open Buffer API for custom workflows", "file_type": "concept", "source_file": "eval/cases/fixtures/E17-agency-blog-2026-06-17.txt", "source_location": null, "source_url": null, "captured_at": "2026-06-17", "author": null, "contributor": null}, {"id": "eval_cases_fixtures_e17_agency_blog_2026_06_17_marin_nedelev_case", "label": "Marin Nedelev: 77 channels across nine countries via API + Google Sheets + n8n", "file_type": "concept", "source_file": "eval/cases/fixtures/E17-agency-blog-2026-06-17.txt", "source_location": null, "source_url": null, "captured_at": "2026-06-17", "author": null, "contributor": null}, {"id": "eval_cases_fixtures_e17_agency_blog_2026_06_17_mcp_server_agents", "label": "Buffer MCP server connects to Claude and ChatGPT", "file_type": "concept", "source_file": "eval/cases/fixtures/E17-agency-blog-2026-06-17.txt", "source_location": null, "source_url": null, "captured_at": "2026-06-17", "author": null, "contributor": null}, {"id": "eval_cases_fixtures_e17_agency_blog_2026_06_17_partner_program", "label": "Buffer partner program (revenue share for recommendations)", "file_type": "concept", "source_file": "eval/cases/fixtures/E17-agency-blog-2026-06-17.txt", "source_location": null, "source_u