{"nodes": [{"id": "docs_screenshots_02_hypothesis_revised_h7", "label": "Screenshot: Hypothesis H7 revised (insights feed)", "file_type": "image", "source_file": "docs/screenshots/02-hypothesis-revised-h7.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_screenshots_02_hypothesis_revised_h7_hypothesis_card", "label": "Hypothesis card (dark-theme stacked feed of competitor hypotheses)", "file_type": "concept", "source_file": "docs/screenshots/02-hypothesis-revised-h7.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each hypothesis is a self-contained card so a user can scan status, current claim, confidence, and history at a glance without leaving the feed."}, {"id": "docs_screenshots_02_hypothesis_revised_h7_hypothesis_h7_hybrid_acquisition_model", "label": "H7: Buffer acquires agency customers via hybrid model incl. Agency Partner Program (25% recurring commission)", "file_type": "concept", "source_file": "docs/screenshots/02-hypothesis-revised-h7.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Revised in Run 3 from the prior claim that Buffer avoided partner networks; June 2026 blog (F254) and October agency page (F261, F265, F287) show a formalized partner program; confidence moved 56% to 70%."}, {"id": "docs_screenshots_02_hypothesis_revised_h7_hypothesis_h8_tiered_per_channel_pricing", "label": "H8: Buffer's 'more options' for large channel counts materialized as tiered per-channel pricing on Team plan", "file_type": "concept", "source_file": "docs/screenshots/02-hypothesis-revised-h7.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Revised in Run 3: prior claim of a higher-touch or custom-priced enterprise tier was replaced because evidence showed aggressive tiered per-channel pricing instead; confidence 70%."}, {"id": "docs_screenshots_02_hypothesis_revised_h7_hypothesis_h9_agency_partner_program_launch", "label": "H9: Buffer launched a formal Agency Partner Program with 25% recurring commission (active)", "file_type": "concept", "source_file": "docs/screenshots/02-hypothesis-revised-h7.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_screenshots_02_hypothesis_revised_h7_buffer_agency_partner_program", "label": "Buffer Agency Partner Program (25% recurring commission, priority support, playbooks, co-marketing)", "file_type": "concept", "source_file": "docs/screenshots/02-hypothesis-revised-h7.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_screenshots_02_hypothesis_revised_h7_hypothesis_status_badge", "label": "Hypothesis status badge (revised / active)", "file_type": "concept", "source_file": "docs/screenshots/02-hypothesis-revised-h7.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Purple outline pill for 'revised' vs neutral 'active' makes changed conclusions visually distinct from stable ones."}, {"id": "docs_screenshots_02_hypothesis_revised_h7_category_tag", "label": "Hypothesis category tag (Distribution, Next moves)", "file_type": "concept", "source_file": "docs/screenshots/02-hypothesis-revised-h7.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_screenshots_02_hypothesis_revised_h7_strikethrough_prior_claim", "label": "Strikethrough of superseded prior claim above the new claim", "file_type": "concept", "source_file": "docs/screenshots/02-hypothesis-revised-h7.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Showing the old text struck through directly above the replacement lets the reader see exactly what the system changed its mind about, rather than hiding the revision."}, {"id": "docs_screenshots_02_hypothesis_revised_h7_confidence_bar", "label": "Confidence bar with percentage (e.g. 70%, 56% -> 70%)", "file_type": "concept", "source_file": "docs/screenshots/02-hypothesis-revised-h7.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Teal progress bar plus numeric value communicates calibrated confidence; the history entry shows the delta so confidence changes are auditable."}, {"id": "docs_screenshots_02_hypothesis_revised_h7_correct_this_interpretation_button", "label": "'Correct this interpretation' button (human feedback on hypothesis)", "file_type": "concept", "source_file": "docs/screenshots/02-hypothesis-revised-h7.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every card exposes a correction affordance so users can push back on LLM-generated conclusions and keep the model honest."}, {"id": "docs_screenshots_02_hypothesis_revised_h7_history_timeline", "label": "History section ('N updates - how this conclusion changed') with per-run revision entries", "file_type": "concept", "source_file": "docs/screenshots/02-hypothesis-revised-h7.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Expandable history per hypothesis provides provenance: which run changed it, old vs new confidence, and the reasoning."}, {"id": "docs_screenshots_02_hypothesis_revised_h7_revision_rationale", "label": "Revision rationale text with alternative explanation", "file_type": "concept", "source_file": "docs/screenshots/02-hypothesis-revised-h7.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The rationale explicitly states an alternative explanation (e.g. lightweight affiliate link vs true partner program) and why it was rejected, which is a deliberate anti-overclaiming pattern."}, {"id": "docs_screenshots_02_hypothesis_revised_h7_fact_citation_links", "label": "Inline fact citation links (F254, F261, F265, F287, F305, F255, F269) with 'N facts cited - show quotes'", "file_type": "concept", "source_file": "docs/screenshots/02-hypothesis-revised-h7.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every claim in the rationale is traceable to a numbered extracted fact, and quotes can be expanded, so conclusions are grounded in evidence rather than free-form LLM text."}, {"id": "docs_screenshots_02_hypothesis_revised_h7_run_attribution", "label": "Run attribution label ('H7 - updated in Run 3')", "file_type": "concept", "source_file": "docs/screenshots/02-hypothesis-revised-h7.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_screenshots_02_hypothesis_revised_h7", "target": "docs_screenshots_02_hypothesis_revised_h7_hypothesis_card", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/screenshots/02-hypothesis-revised-h7.png", "source_location": null, "weight": 1.0}, {"source": "docs_screenshots_02_hypothesis_revised_h7", "target": "docs_screenshots_02_hypothesis_revised_h7_hypothesis_h7_hybrid_acquisition_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/screenshots/02-hypothesis-revised-h7.png", "source_location": null, "weight": 1.0}, {"source": "docs_screenshots_02_hypothesis_revised_h7", "target": "docs_screenshots_02_hypothesis_revised_h7_hypothesis_h8_tiered_per_channel_pricing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/screenshots/02-hypothesis-revised-h7.png", "source_location": null, "