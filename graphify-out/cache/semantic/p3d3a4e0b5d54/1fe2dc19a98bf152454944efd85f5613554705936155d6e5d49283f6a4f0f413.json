{"nodes": [{"id": "docs_screenshots_01_overview_what_changed_run3", "label": "Screenshot: Overview tab with 'What changed in Run 3' strip (Buffer competitor)", "file_type": "image", "source_file": "docs/screenshots/01-overview-what-changed-run3.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Dark-theme UI screenshot of the Delta competitive intelligence app showing the Buffer competitor page, a run strip with three completed runs, and the 'What changed in Run 3' overview strip listing insight hypotheses with status badges and confidence deltas."}, {"id": "docs_screenshots_01_overview_what_changed_run3_delta_app", "label": "Delta competitive intelligence analyst", "file_type": "concept", "source_file": "docs/screenshots/01-overview-what-changed-run3.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Header brand: 'Delta - competitive intelligence analyst', analysing competitors on behalf of a customer ('for Loop'), with a Settings link."}, {"id": "docs_screenshots_01_overview_what_changed_run3_competitor_profile_header", "label": "Competitor profile header (Buffer)", "file_type": "concept", "source_file": "docs/screenshots/01-overview-what-changed-run3.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Competitor name, domain (buffer.com) and a one-paragraph summary: social media scheduling tool, founded 2010, fully remote, transparent per-channel pricing serving creators, small businesses and agencies."}, {"id": "docs_screenshots_01_overview_what_changed_run3_archive_replay_banner", "label": "Archive replay banner", "file_type": "concept", "source_file": "docs/screenshots/01-overview-what-changed-run3.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Blue callout: 'Replaying 18 archived pages published Aug 1, 2022 - Oct 31, 2026. Each run only sees pages dated on or before its cutoff.'", "rationale": "Demo mode replays a fixed corpus of archived pages so each run is time-sliced by a cutoff date, letting the product show how insights evolve across runs without live crawling."}, {"id": "docs_screenshots_01_overview_what_changed_run3_run_strip", "label": "Run strip (Run 1-3 cutoffs, facts, insights)", "file_type": "concept", "source_file": "docs/screenshots/01-overview-what-changed-run3.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Horizontal chips: Run 1 <= Dec 31, 2023 (41 facts, 3 insights); Run 2 <= Dec 31, 2024 (32 facts, 4 insights); Run 3 <= Oct 31, 2026 (82 facts, 4 insights). Status text: '1 page waiting - 7 follow-ups queued'."}, {"id": "docs_screenshots_01_overview_what_changed_run3_run_run_4_button", "label": "Run Run 4 button (pages dated <= Nov 1, 2026)", "file_type": "concept", "source_file": "docs/screenshots/01-overview-what-changed-run3.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Primary teal call-to-action that starts the next pipeline run with the next cutoff date, placed at the right end of the run strip.", "rationale": "Shows the next cutoff inline so the user knows exactly which archived pages the new run will see before starting it."}, {"id": "docs_screenshots_01_overview_what_changed_run3_tab_navigation", "label": "Tab navigation (Overview, Timeline, Insights, Evidence, Questions)", "file_type": "concept", "source_file": "docs/screenshots/01-overview-what-changed-run3.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Five tabs with count badges: Overview 9, Timeline 13, Insights 11, Evidence 18, Questions 7. Overview is active."}, {"id": "docs_screenshots_01_overview_what_changed_run3_what_changed_strip", "label": "What changed in Run 3 strip", "file_type": "concept", "source_file": "docs/screenshots/01-overview-what-changed-run3.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Overview section headed 'WHAT CHANGED IN RUN 3' with a link 'Run details - 8m 57s'. Summary row: created 3, strengthened 4, revised 2, retired 2, 3 questions resolved, 4 questions raised, 4 timeline events, 4 insights. Below it, one row per insight hypothesis (H1-H9) with a status badge, hypothesis text and confidence delta.", "rationale": "Surfaces the delta between runs as the first thing a user sees so they do not have to diff the full insight list themselves; the run duration link gives a path to the detailed run page."}, {"id": "docs_screenshots_01_overview_what_changed_run3_insight_status_badges", "label": "Insight status badges (created / strengthened / revised / retired)", "file_type": "concept", "source_file": "docs/screenshots/01-overview-what-changed-run3.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Pill badges colour-coded per lifecycle state: created (teal), strengthened (green), revised (blue), retired (grey, dimmed text). Each insight row leads with its badge and an H-number identifier.", "rationale": "Four lifecycle states let a run express not just new findings but also reinforcement, correction and abandonment of earlier hypotheses."}, {"id": "docs_screenshots_01_overview_what_changed_run3_confidence_delta", "label": "Confidence delta (before -> after %)", "file_type": "concept", "source_file": "docs/screenshots/01-overview-what-changed-run3.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Right-aligned column per row showing prior and new confidence with an arrow, e.g. '78% -> 85% up', '56% -> 56% =', and a bare '75%' for newly created insights."}, {"id": "docs_screenshots_01_overview_what_changed_run3_revised_insight_strikethrough", "label": "Revised insight strikethrough pattern", "file_type": "concept", "source_file": "docs/screenshots/01-overview-what-changed-run3.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "For revised insights (H7, H8) the old hypothesis text is shown struck through and dimmed, immediately followed by the new wording in normal text, so the change is readable inline.", "rationale": "Inline strikethrough keeps the old and new claims side by side so a reader can judge what exactly was corrected without opening a diff view."}, {"id": "docs_screenshots_01_overview_what_changed_run3_retired_insight_pointer", "label": "Retired insight successor pointer (-> H7)", "file_type": "concept", "source_file": "docs/screenshots/01-overview-what-changed-run3.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Retired insights (H4, H6) end with an arrow link to the insight that supersedes them (-> H7, -> H8), and their confidence shows no change (56% -> 56% =)."}, {"id": "docs_screenshots_01_overview_what_changed_run3_agency_partner_program_insight", "label": "Insight H9: Buffer Agency Partner Program (25% recurring commission)", "file_type": "concept", "source_file": "docs/screenshots/01-overview-what-changed-run3.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Example created insight at 75% confidence: Buffer launched a formal Agency Partner Program with 25% recurring commission, adding a partner-led acquisition motion and competing directly for agency referrals."}, {"id": "docs_screenshots_01_overview_what_changed_run3_loop_customer_context", "label": "Customer context: 'for Loop'", "file_type": "concept", "source_file": "docs/screenshots/01-overview-what-changed-run3.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Header shows the analysis is run on behalf of 'Loop'; several hypotheses compare Buffer to Loop's per-client workspace pricing and client-centric organisation."}], "edges": [{"source": "docs_screenshots_01_overview_what_changed_run3", "target": "docs_screenshots_01_overview_what_changed_run3_delta_app", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/screenshots/01-overview-what-changed-run3.png", "source_location": null, "weight": 1.0}, {"source": "docs_screenshots_01_overview_what_changed_run3", "target": "docs_screenshots_01_overview_what_changed_run3_competitor_profile_header", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/screenshots/01-overview-what-changed-run3.png", "source_location": null, "weight": 1.0}, {"source": "docs_screenshots_01_overview_what_changed_run3", "target": "docs_screenshots_01_overview_what_changed_run3_archive_replay_banner", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/screenshots/01-overview-what-changed-run3.png", "source_location": null, "weight": 1.0}, {"source": "docs_screenshots_01_overview_what_changed_run3", "target": "docs_screenshots_01_overview_what_changed_run3_run_strip", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/screenshots/01-overview-what-changed-run3.png", "source_location": null, "weight": 1.0}, {"source": "docs_screenshots_01_overview_what_changed_run3", "target": "docs_screenshots_01_overview_what_changed_run3_tab_navigation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/screenshots/01-overview-what-changed-run3.png", "source_location": null, "weight": 1.0}, {"source": "docs_screenshots_01_overview_what_changed_