# ── Models ──────────────────────────────────────────────────────────────────
# One model per role, as provider:model. Providers: anthropic | openai (any OpenAI-compatible endpoint).
# Defaults: anthropic:claude-haiku-5-5 for extraction and anthropic:claude-opus-5-5 for synthesis.
# If only an OpenAI-compatible key is set, the defaults become openai:step-3.7-flash / openai:step-5-preview,
# or openai:gpt-6-luna / openai:gpt-6.1-sol when OPENAI_COMPAT_BASE_URL is https://api.openai.com/v1.
# LLM_EXTRACT=anthropic:claude-haiku-5-5
# LLM_SYNTH=anthropic:claude-opus-5-5
# Reasoning effort per role: low | medium | high (defaults: extract=low, synth=high).
# LLM_EXTRACT_EFFORT=low
# LLM_SYNTH_EFFORT=high
# Extra OpenAI-compatible models that accept reasoning_effort (step-3.7-flash, gpt-6-luna and gpt-6.1-sol are built in), comma-separated.
# LLM_REASONING_EFFORT_MODELS=
# Sampling temperature for OpenAI-compatible models (Claude ignores it). Default 0.2; none on OpenAI's API, whose GPT-6 models reject it.
# LLM_OPENAI_TEMPERATURE=0.2
# USD per million tokens for cost estimates, e.g. {"step-3.7-flash":{"input":0.1,"output":0.3}}.
# LLM_PRICES_JSON=

# ── Credentials ─────────────────────────────────────────────────────────────
# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...
# OpenAI-compatible endpoint, e.g. StepFun (https://platform.stepfun.ai), OpenAI, OpenRouter, Groq, Ollama.
# STEPFUN_API_KEY / STEPFUN_BASE_URL still work as aliases.
# OPENAI_COMPAT_BASE_URL=https://api.stepfun.ai/v1
# OPENAI_COMPAT_API_KEY=sk-...

# ── Hosting (docker-compose) ────────────────────────────────────────────────
# Public hostname Caddy serves; TLS is automatic once DNS points here.
# DELTA_HOST=delta.example.com
# Dashboard password. Hash with: docker run --rm caddy:2 caddy hash-password --plaintext '<password>'
# Keep the hash in single quotes: it contains $ characters.
# DELTA_BASIC_USER=delta
# DELTA_BASIC_HASH='$2a$14$...'
# Timezone for logs and the default schedule.
# TZ=UTC

# ── Instance ────────────────────────────────────────────────────────────────
# Public base URL of this Delta instance; used in links, webhooks and the crawler's user agent (+<url>/about-bot).
# DELTA_BASE_URL=http://localhost:3000

# Secret that signs reaction links in digests: openssl rand -base64 32
# DELTA_LINK_SECRET=

# ── Discovery (Exa) ──────────────────────────────────────────────────────────
# Off-domain discovery (news, press, reviews) and absence checks use Exa search: https://dashboard.exa.ai
# EXA_API_KEY=

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Sending: verify a domain in the Resend dashboard, then set digest.to in Settings.
# A send-only key is enough. Readers answer through a link in the digest, not by email.
# RESEND_API_KEY=re_...
# Default From until one is saved in Settings. The name is what recipients see first, so keep it "Delta".
# DELTA_DIGEST_FROM="Delta <delta@notify.example.com>"

# ── Storage ─────────────────────────────────────────────────────────────────
# SQLite file path (default: data/delta.db)
# DELTA_DB_PATH=data/delta.db

# Set to 1 to use canned model responses (no network). Tests set this automatically.
# DELTA_MOCK_LLM=0
